{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(./studio *)",
      "Bash(./studio.cmd *)",
      "Bash(tools/uv/uv run *)",
      "Bash(tools/ffmpeg/ffmpeg *)",
      "Bash(tools/ffmpeg/ffprobe *)",
      "PowerShell(.\\studio.cmd *)",
      "PowerShell(./studio.cmd *)",
      "PowerShell(.\\tools\\uv\\uv.exe run *)",
      "Read(./projects/**)",
      "Read(./output/**)",
      "Read(./input/**)",
      "Read(./tools/studio/docs/**)",
      "WebFetch(domain:remotion.dev)",
      "WebFetch(domain:www.remotion.dev)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "Read(./api-keys.txt)",
      "Edit(./api-keys.txt)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "HF_HUB_DISABLE_SYMLINKS_WARNING": "1",
    "DISABLE_TELEMETRY": "1"
  }
}
